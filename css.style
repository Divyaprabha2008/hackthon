
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #e9eaf2;
    color: #252344;
}

.app {
    max-width: 480px;
    min-height: 100vh;
    margin: auto;
    background: #f7f7fc;
    padding-bottom: 85px;
}

header {
    background: #302b63;
    color: white;
    padding: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header p {
    font-size: 12px;
    margin-top: 5px;
    color: #ddd9ff;
}

.bell {
    background: #514b8a;
    border: none;
    border-radius: 50%;
    padding: 12px;
    color: white;
}

.welcome {
    background: #302b63;
    color: white;
    padding: 15px 22px 35px;
    border-radius: 0 0 25px 25px;
}

.welcome p {
    margin-bottom: 10px;
    color: #dedaff;
}

.welcome h2 {
    font-size: 26px;
}

.summary {
    background: white;
    margin: -18px 18px 25px;
    padding: 20px;
    border-radius: 15px;
    display: flex;
    justify-content: space-between;
    box-shadow: 0 3px 12px #ddd;
}

.summary h2 {
    font-size: 19px;
    margin-top: 10px;
    color: #5547ae;
}

.summary span {
    color: #20aa72;
    font-size: 22px;
}

.content, .subpage {
    padding: 20px;
}

.content h3, .subpage h2 {
    margin-bottom: 18px;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.feature {
    background: white;
    padding: 20px 15px;
    border-radius: 15px;
    box-shadow: 0 3px 10px #e1e1e9;
    cursor: pointer;
}

.feature span {
    font-size: 30px;
}

.feature h4 {
    margin: 12px 0 7px;
}

.feature p {
    color: #777;
    font-size: 12px;
}

.notice {
    margin-top: 25px;
    background: #e9e6ff;
    padding: 20px;
    border-radius: 15px;
}

.notice p {
    font-size: 13px;
    margin-top: 10px;
}

.hidden {
    display: none !important;
}

.subpage {
    min-height: 65vh;
}

.back {
    border: none;
    background: transparent;
    color: #5146a5;
    padding: 10px 0;
    font-size: 16px;
    margin-bottom: 20px;
}

form {
    background: white;
    padding: 18px;
    border-radius: 15px;
}

label {
    display: block;
    font-size: 13px;
    margin-top: 15px;
    font-weight: bold;
}

input {
    width: 100%;
    padding: 13px;
    margin-top: 7px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 14px;
}

.primary, .secondary {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 9px;
    margin-top: 18px;
    cursor: pointer;
    font-weight: bold;
}

.primary {
    background: #5146a5;
    color: white;
}

.secondary {
    background: #e9e6ff;
    color: #5146a5;
}

.status-card, .location-card, .history-item {
    background: white;
    padding: 20px;
    border-radius: 15px;
    line-height: 1.8;
    margin-bottom: 15px;
}

.location-card {
    text-align: center;
}

.location-card span {
    font-size: 40px;
}

#locationResult {
    margin-top: 20px;
    overflow-wrap: anywhere;
}

#locationResult a {
    color: #5146a5;
}

nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    background: white;
    display: flex;
    justify-content: space-around;
    padding: 12px 3px;
    box-shadow: 0 -3px 12px #ddd;
}

nav button {
    border: none;
    background: white;
    color: #5146a5;
    font-size: 20px;
    cursor: pointer;
}

nav small {
    display: block;
    font-size: 10px;
    margin-top: 5px;
}

@media (min-width: 600px) {
    .app {
        margin: 20px auto;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 5px 25px #ccc;
    }
}
